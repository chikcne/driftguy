[Unit]
Description=Driftguy production build

[Service]
Environment=BIND=0.0.0.0
Environment=PORT=5300
Environment=HOST_DIR=%h/.t3/hosted/driftguy
ExecStart=/usr/bin/env python3 -m http.server ${PORT} --bind ${BIND} --directory ${HOST_DIR}/current
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
